---
/**
 * realisations.astro - liste des projets, générée depuis la collection
 * `projets` (une fiche Markdown par projet dans src/content/projets/,
 * schéma dans src/content.config.ts). Ajouter un projet = ajouter une fiche :
 * sa carte apparaît ici et sa page de détail est générée par
 * realisations/[slug].astro. UDPS 56 volontairement absent : projet en
 * stand-by (contenu/décision pas prêts).
 *
 * Aperçu de chaque carte : vidéo (Axel Mahé) ou image (Chewcast, Portfolio
 * personnel), cf. `preview.kind` dans la fiche. Les assets vivent dans
 * src/assets/previews/ (paramètres de régénération dans son README ; la
 * vidéo brute d'Axel Mahé, ~11 Mo, reste dans son propre repo).
 *
 * kind: "client" affiche le rôle en accent (couleur de marque), réservé aux
 * vraies livraisons. kind: "perso" affiche "Projet personnel" en ton neutre :
 * distingue visuellement sans écarter ces projets de la page (ils montrent
 * une palette de compétences réelle, juste non commanditée).
 */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";

// Vidéos d'aperçu : référencées par nom de fichier dans les fiches (le
// helper image() du schéma ne gère que les images), résolues ici en URL
// fingerprintée par Vite.
const videos = import.meta.glob<string>("../assets/previews/*.{webm,mp4}", {
  eager: true,
  query: "?url",
  import: "default",
});
function videoUrl(file: string): string {
  const url = videos[`../assets/previews/${file}`];
  if (!url) throw new Error(`Aperçu vidéo introuvable : src/assets/previews/${file}`);
  return url;
}

const projects = (await getCollection("projets")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Réalisations - Chewbackk Studio"
  description="Projets récents livrés par Chewbackk Studio : portfolios, applications, sites vitrines."
>
  <PageHead idx="03" label="Réalisations" title="Des projets livrés">
    Un aperçu de ce qui a déjà été construit. La liste s'allonge au fil des
    projets.
  </PageHead>

  <section class="projects">
    <div class="container projects__grid">
      {
        projects.map(({ id, data: p }) => (
          <article class="project">
            {/* Aperçus purement décoratifs : tout ce qu'ils montrent (nom,
                rôle, description) est déjà porté par le texte juste en
                dessous — aria-hidden/alt="" plutôt qu'un label qui
                doublonnerait l'annonce pour un lecteur d'écran, cohérent
                avec HeroBlueprint.astro et ServicesPreview.astro. */}
            <div class={`project__preview project__preview--${p.preview.fit}`} aria-hidden="true">
              {p.preview.kind === "video" ? (
                <>
                  <video
                    class="project__preview-media project__preview-media--motion"
                    poster={p.preview.poster.src}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="auto"
                  >
                    <source src={videoUrl(p.preview.webm)} type="video/webm" />
                    <source src={videoUrl(p.preview.mp4)} type="video/mp4" />
                  </video>
                  <img
                    class="project__preview-media project__preview-media--static"
                    src={p.preview.poster.src}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </>
              ) : (
                <img
                  class="project__preview-media"
                  src={p.preview.image.src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>

            <div class="project__body">
              <div class="project__head">
                <h2 class="project__name">{p.name}</h2>
                <span class="project__year">{p.year}</span>
              </div>
              {p.kind === "client" ? (
                <p class="project__role">{p.role}</p>
              ) : (
                <p class="project__role project__role--perso">Projet personnel</p>
              )}
              <p class="project__desc">{p.summary}</p>
              <ul class="project__tags">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              {p.url && (
                <a
                  class="project__link project__link--external"
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Voir le site &rarr;
                </a>
              )}
            </div>

            {/* Stretched link : rend toute la carte cliquable vers la page de
                détail, sans imbriquer un <a> dans un autre (invalide en
                HTML) — cet <a> est un sibling positionné en absolute/inset:0
                avec un z-index bas ; le lien externe "Voir le site" reçoit
                lui un z-index plus élevé pour rester cliquable
                indépendamment par-dessus. Pas de texte visible : le nom/la
                description du projet sont déjà juste au-dessus dans le DOM,
                d'où l'aria-label plutôt qu'un contenu qui doublonnerait
                l'annonce pour un lecteur d'écran. */}
            <a
              class="project__stretched-link"
              href={`/realisations/${id}`}
              aria-label={`Voir le détail du projet ${p.name}`}
            />
          </article>
        ))
      }

      <article class="project project--placeholder">
        <div class="project__body project__body--placeholder">
          <div class="project__head">
            <h2 class="project__name">Votre projet</h2>
          </div>
          <p class="project__desc">
            La prochaine réalisation pourrait être la vôtre. Parlons-en.
          </p>
          <a class="project__link" href="/contact">Démarrer un projet &rarr;</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .projects {
    /* Hauteur partagée par la fenêtre d'aperçu et le placeholder, pour que
       toutes les cartes s'alignent sur la même grille — cf. --bp-cell dans
       HeroBlueprint.astro pour le même pattern de variable locale. */
    --preview-h: 15rem;
    padding-block: var(--sp-8) var(--section-pad);
  }
  .projects__grid {
    display: grid;
    gap: var(--sp-6);
    align-items: start;
  }
  @media (min-width: 720px) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project {
    position: relative;
    display: grid;
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .project--placeholder {
    border-style: dashed;
    color: var(--c-ink-muted);
  }

  /* Stretched link (pattern Bootstrap) : couvre toute la carte, sous le lien
     externe "Voir le site" (z-index plus élevé, voir .project__link--external)
     mais au-dessus de l'aperçu/texte non interactifs. Absent de la carte
     placeholder "Votre projet", qui garde uniquement son lien "Démarrer un
     projet". */
  .project__stretched-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Fenêtre d'aperçu — hauteur fixe partagée par toutes les cartes, chaque
     média garde son ratio naturel dedans (cover pour les formats larges,
     contain + fond sombre pour la capture mobile de Chewcast, qui reste
     ainsi lisible en entier plutôt que rognée sur les côtés). */
  .project__preview {
    aspect-ratio: unset;
    height: var(--preview-h);
    background: var(--c-bg-elev);
    border-bottom: 1px solid var(--c-line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .project__preview-media {
    width: 100%;
    height: 100%;
    display: block;
  }
  .project__preview--cover .project__preview-media {
    object-fit: cover;
  }
  .project__preview--contain .project__preview-media {
    object-fit: contain;
  }
  /* Le poster statique (fallback prefers-reduced-motion) est superposé au
     même emplacement que la vidéo mais cachée par défaut — seule la requête
     média ci-dessous choisit laquelle des deux s'affiche. */
  .project__preview-media--static {
    display: none;
  }

  .project__body {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    padding: var(--sp-6);
  }
  .project__body--placeholder {
    align-content: center;
    min-height: var(--preview-h);
  }
  .project__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .project__name {
    font-size: var(--fs-step-2);
    margin: 0;
  }
  .project__year {
    font-family: var(--font-mono);
    font-size: var(--fs-step--1);
    color: var(--c-ink-muted);
  }
  .project__role {
    font-size: var(--fs-step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-accent);
    margin: 0;
  }
  .project__role--perso {
    color: var(--c-ink-muted);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
  .project__desc {
    color: var(--c-ink-muted);
    margin: 0;
  }
  .project__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
  }
  .project__tags li {
    font-family: var(--font-mono);
    font-size: var(--fs-step--1);
    color: var(--c-ink-muted);
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    padding: 0.2em 0.6em;
  }
  .project__link {
    margin-top: var(--sp-2);
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--c-line);
    width: fit-content;
  }
  .project__link:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }
  /* Doit rester cliquable indépendamment du lien étiré (.project__stretched-link,
     z-index:1) posé par-dessus toute la carte : position relative + z-index
     supérieur explicite pour gagner l'empilement. */
  .project__link--external {
    position: relative;
    z-index: 2;
  }

  /* Une vidéo qui boucle en continu est superflue si le visiteur a demandé
     moins de mouvement — bascule vers l'image statique (même cadrage, une
     seule frame) au lieu de la vidéo autoplay. */
  @media (prefers-reduced-motion: reduce) {
    .project__preview-media--motion {
      display: none;
    }
    .project__preview-media--static {
      display: block;
    }
  }
</style>
