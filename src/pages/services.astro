---
/**
 * services.astro - détail des 4 catégories de services (brief §2).
 * Pas de prix affichés : le devis est fait sur mesure via /contact.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import CtaSection from "../components/CtaSection.astro";

const categories = [
  {
    num: "01",
    title: "Sites web",
    items: [
      "Site vitrine (TPE, artisans, pros)",
      "Landing page",
      "Portfolio",
      "Site avec back-end (espace client, e-commerce, réservation)",
    ],
  },
  {
    num: "02",
    title: "Développement, automatisation et scripts",
    items: [
      "Application web",
      "Scripts et automatisations",
      "Bots (hors Discord)",
      "Intégrations API",
    ],
  },
  {
    num: "03",
    title: "Discord",
    items: ["Configuration de serveur", "Bot Discord custom"],
  },
  {
    num: "04",
    title: "Autres",
    items: ["Tout projet qui ne rentre pas dans les cases, sur devis"],
  },
];
---

<BaseLayout
  title="Services - Chewbackk Studio"
  description="Sites vitrines, applications, automatisations, bots Discord. Devis sur mesure, sans prix affichés à l'avance."
>
  <PageHead idx="02" label="Services" title="Des services à la carte">
    Du site vitrine simple à l'application avec back-end. Pas de prix
    affichés ici : chaque projet est différent, le devis se fait sur
    mesure via le formulaire de contact.
  </PageHead>

  <section class="cats">
    <div class="container">
      {
        categories.map((c) => (
          <article class="cat">
            <div class="cat__head">
              <span class="cat__num">{c.num}</span>
              <h2 class="cat__title">{c.title}</h2>
            </div>
            <ul class="cat__items">
              {c.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <CtaSection title="Un projet en tête ?">
    Décrivez-le en quelques lignes, vous recevez une réponse sous 48 h
    avec une fourchette de budget indicative.
    <a slot="actions" class="btn btn--cta" href="/contact">Démarrer un projet</a>
  </CtaSection>
</BaseLayout>

<style>
  .cats {
    padding-block: var(--sp-8) var(--section-pad);
  }
  .cat {
    display: grid;
    gap: var(--sp-4);
    padding-block: var(--sp-8);
    border-top: 1px solid var(--c-line);
  }
  .cat:last-child {
    border-bottom: 1px solid var(--c-line);
  }
  .cat__head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }
  .cat__num {
    font-family: var(--font-mono);
    color: var(--c-ink-muted);
    font-size: var(--fs-step-0);
  }
  .cat__title {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.2rem);
    margin: 0;
  }
  .cat__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    max-width: 48rem;
  }
  .cat__items li {
    position: relative;
    padding-left: var(--sp-4);
    color: var(--c-ink-muted);
  }
  .cat__items li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--c-accent);
  }
</style>
